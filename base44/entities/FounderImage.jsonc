{
  "name": "FounderImage",
  "type": "object",
  "properties": {
    "founderId": {
      "type": "string",
      "description": "Unique identifier for the founder (e.g. 'charlie', 'jason')"
    },
    "imageUrl": {
      "type": "string",
      "description": "URL of the founder's portrait photo"
    }
  },
  "required": [
    "founderId",
    "imageUrl"
  ]
}